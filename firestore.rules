rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Function: Validate Auth & Active Admin Role
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'Active';
    }

    // Public Collections - Read Publicly, Write Admin Only
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restricted Admin Audit Logs
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admin Users Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
